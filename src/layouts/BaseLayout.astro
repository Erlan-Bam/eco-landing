---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content } from "../data/content.mjs";
import { canonicalUrl, getAlternateLinks, getOrganizationJsonLd, getPageMeta, getRoute, hasConfiguredSiteUrl } from "../utils/site.mjs";

interface Props {
  locale?: "ru" | "kz";
  page?: "home" | "services";
}

const { locale = "ru", page = "home" } = Astro.props;
const lang = locale === "kz" ? "kk" : "ru";
const meta = getPageMeta(locale, page);
const pathname = getRoute(locale, page);
const hasPublicSiteUrl = hasConfiguredSiteUrl();
const alternates = hasPublicSiteUrl ? getAlternateLinks(page) : [];
const jsonLd = getOrganizationJsonLd(locale, { includeUrl: hasPublicSiteUrl });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {hasPublicSiteUrl && <link rel="canonical" href={canonicalUrl(pathname)} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    {hasPublicSiteUrl && <link rel="alternate" hreflang="x-default" href={canonicalUrl("/")} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {hasPublicSiteUrl && <meta property="og:url" content={canonicalUrl(pathname)} />}
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="preload" href="/fonts/tbank/TinkoffSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tbank/TinkoffSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tbank/TinkoffSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "kz" ? "Негізгі мазмұнға өту" : "Перейти к содержимому"}</a>
    <Header locale={locale} nav={content[locale].nav} page={page} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
